# PostgreSQL (metadata / crawl state / graph / experiments — never in the query hot path)
DATABASE_URL=postgres://aero:aero@localhost:5432/aero_search

# API
PORT=3000
HOST=127.0.0.1

# Crawler safety limits (controlled corpus — these are hard constraints)
CRAWL_MAX_PAGES=1000
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_MS=1000
CRAWL_ALLOWLIST=example.com

# Index
INDEX_DIR=data/index
