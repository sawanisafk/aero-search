# PostgreSQL (metadata / crawl state / graph / experiments — never in the query hot path)
# If unreachable or unset, scripts boot an embedded PostgreSQL (ADR-011, docs/DATABASE.md).
DATABASE_URL=postgres://aero:aero@localhost:5432/aero_search

# API
PORT=3000
HOST=127.0.0.1

# Crawl limits live in configs/crawl.json (committed): seeds, allowlist,
# maxPages, maxDepth, delayMs, userAgent — see docs/CRAWLER.md.

# Index
INDEX_DIR=data/index
